# Copy to dossier_agent/.env (adk web reads the .env in the agent folder).
# Never commit the real .env: secrets live only there.
# Docker reads the same file (--env-file): KEY=value lines, no quotes, no `export`.

# --- Model access: Gemini API key (default) --------------------------------
# Get a key at https://aistudio.google.com/apikey. A free-tier key works, but
# its rate limits can slow a run down (requests are retried, see MODEL_ATTEMPTS).
GOOGLE_API_KEY=
# Alternative: Vertex AI instead of the API key (needs a GCP project and
#   gcloud auth application-default login). Uncomment and leave GOOGLE_API_KEY empty:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=<your-project-id>
# GOOGLE_CLOUD_LOCATION=global
# Do NOT also set GOOGLE_GENAI_USE_ENTERPRISE: in google-genai 2.x it overrides
# GOOGLE_GENAI_USE_VERTEXAI when the two disagree.

# --- Model -------------------------------------------------------------------
# Gemini API: gemini-3.7-flash is answered by gemini-3.8-flash, so use 3.8 directly.
# Prices for the cost limit: dossier_agent/pricing.py (unknown model = most expensive).
MODEL=gemini-3.8-flash
# Optional stronger model for the writer only. Empty = MODEL.
WRITER_MODEL=
# Thinking level: minimal | low | medium | high. Unset judge = low; empty = model default.
# JUDGE_THINKING_LEVEL=low
WRITER_THINKING_LEVEL=
# Attempts per model request, the first one included (retries on 408/429/5xx).
# MODEL_ATTEMPTS=4

# --- Hard stops (checked before every model call) --------------------------
MAX_LLM_CALLS=50
COST_LIMIT_USD=0.40
TIME_LIMIT_SECONDS=540
MAX_SEARCHES=15
# research loop ends at this share of COST_LIMIT_USD, the rest is for the writer
SOFT_BUDGET_SHARE=0.7

# --- Service (POST /run) -------------------------------------------------------
# asyncio.wait_for around one run (default TIME_LIMIT_SECONDS + 60).
# A processing/ file older than STALE_AFTER_SECONDS
# (default RUN_TIMEOUT_SECONDS + 120) counts as a cut-off run.
# RUN_TIMEOUT_SECONDS=600
# STALE_AFTER_SECONDS=720

# --- Storage -----------------------------------------------------------------
# Local folder: memory (state/), config/, inbox/ queue and outbox/ results.
# A relative path is relative to the project root.
STORAGE_ROOT=data/storage
